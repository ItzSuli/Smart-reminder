<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#FF6D5DFC"
                android:centerColor="#FF4B3FD6"
                android:endColor="#FF251B6B"
                android:type="linear" />
            <corners android:radius="@dimen/widget_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#33FFFFFF" />
            <corners android:radius="@dimen/widget_corner" />
        </shape>
    </item>
</layer-list>
